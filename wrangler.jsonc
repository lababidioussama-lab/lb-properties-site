{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lababidi-site",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			// The day's chat allowance (see app/api/chat/route.ts).
			"binding": "CHAT_BUDGET",
			"id": "5818466bac3d4f3ca5936d7d87a81c59"
		}
	],
	"services": [
		{
			// The Worker calls itself; the service name must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "lababidi-site"
		}
	],
	"images": {
		// Image optimisation for next/image (resizing and WebP/AVIF).
		"binding": "IMAGES"
	},
	// Run the Worker close to Supabase, not close to each visitor: every page
	// and sign-in makes several database calls, and the distance to the
	// database is what makes the CRM slow, not the distance to the browser.
	"placement": { "mode": "smart" },
	"observability": { "enabled": true }

	// Secrets (SUPABASE_*, SESSION_SECRET, ADMIN_*, RESEND_API_KEY, ...) are not
	// written here: set them in the Cloudflare dashboard (Settings > Variables
	// and Secrets) or with `npx wrangler secret put NAME`.
}
