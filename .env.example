# Copy to .env.local and fill in. Every secret here is server-only — no
# secret carries a NEXT_PUBLIC_ prefix, so none reach the browser bundle.
# (Only the company invoice details below are public, on purpose.)
#
# These same five must also be set on Netlify (Site configuration →
# Environment variables) or the live site will build fine and then fail at
# runtime: the form will not save and /admin will not open.

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project Settings → API → anon / public. Safe to expose in principle: RLS
# gives it INSERT on ten columns and no SELECT at all.
SUPABASE_ANON_KEY=

# Project Settings → API → service_role (hidden behind a "Reveal" button).
# Bypasses RLS entirely. Required for /admin to read leads back. Never give
# this one a NEXT_PUBLIC_ prefix and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- CRM owner account ----------------------------------------------------
# The owner signs in with ADMIN_EMAIL + ADMIN_PASSWORD, then an emailed code.
# Use a long, unique password.
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Signs CRM sessions and sign-in codes. REQUIRED, 32+ random characters,
# and different from ADMIN_PASSWORD (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# --- CRM sign-in code (email) ----------------------------------------------
# The 6-digit code emailed after the password. Verify lababidiproperties.com
# in Resend so codes come from your own domain.
RESEND_API_KEY=
# OTP_FROM="Lababidi Properties CRM <security@lababidiproperties.com>"
# Local testing only — never on the live site:
# CRM_OTP_DISABLED=true

# --- Property portals (Bayut, Dubizzle, Property Finder) --------------------
# One shared secret, or one per portal. 16+ random characters. Give each
# portal: https://crm.lababidiproperties.com/api/leads/portal/<portal>?token=<secret>
PORTAL_WEBHOOK_SECRET=
# BAYUT_WEBHOOK_SECRET=
# DUBIZZLE_WEBHOOK_SECRET=
# PROPERTY_FINDER_WEBHOOK_SECRET=

# --- Domains -----------------------------------------------------------------
# Serve the CRM at this host's root; /admin on the main site redirects here.
CRM_HOST=crm.lababidiproperties.com

# --- Company details on tax invoices ---------------------------------------
# These three are NOT secrets — they print on every invoice, so they carry
# NEXT_PUBLIC_. A UAE tax invoice must show the supplier's TRN.
# NEXT_PUBLIC_COMPANY_TRN=
# NEXT_PUBLIC_COMPANY_ORN=
# NEXT_PUBLIC_COMPANY_ADDRESS="Office …, Business Bay, Dubai, UAE"

# --- AI concierge -------------------------------------------------------
GROQ_API_KEY=

# --- Optional -----------------------------------------------------------
# The testimonials are SAMPLE COPY, not real clients. The section is omitted
# from production builds unless this is explicitly "true". Leave it unset on
# the live site; use it only for a staging demo.
# ALLOW_SAMPLE_TESTIMONIALS=true
