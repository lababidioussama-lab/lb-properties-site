# Copy to .env.local and fill in. Every value here is server-only — none of
# them carry a NEXT_PUBLIC_ prefix, so none reach the browser bundle.
#
# These same five must also be set on Netlify (Site configuration →
# Environment variables) or the live site will build fine and then fail at
# runtime: the form will not save and /admin will not open.

# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Project Settings → API → anon / public. Safe to expose in principle: RLS
# gives it INSERT on ten columns and no SELECT at all.
SUPABASE_ANON_KEY=

# Project Settings → API → service_role (hidden behind a "Reveal" button).
# Bypasses RLS entirely. Required for /admin to read leads back. Never give
# this one a NEXT_PUBLIC_ prefix and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ledger -------------------------------------------------------
# Single shared password for the /admin gate. Minimum 12 characters — below
# that the gate refuses to open rather than pretend to protect anything.
ADMIN_PASSWORD=

# --- AI concierge -------------------------------------------------------
GROQ_API_KEY=

# --- Optional -----------------------------------------------------------
# The testimonials are SAMPLE COPY, not real clients. The section is omitted
# from production builds unless this is explicitly "true". Leave it unset on
# the live site; use it only for a staging demo.
# ALLOW_SAMPLE_TESTIMONIALS=true
